{
  "name": "silveltman",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/translations.ts dist && html-validate dist && linkinator dist",
    "a11y": "pnpm build && playwright install chromium --only-shell && node scripts/a11y.mjs",
    "preview": "astro preview",
    "check": "prettier --check . && tsc --noEmit --noCheck && astro check --minimumFailingSeverity hint && eslint . && knip && node scripts/images.ts --check && node scripts/translations.ts",
    "fix": "prettier --write . && eslint . --fix",
    "images": "node scripts/images.ts",
    "ui:add": "node scripts/ui-add.ts"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^24.19.0",
    "astro-favicons": "^3.1.8",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "html-validate": "^11.16.1",
    "knip": "^6.39.0",
    "linkinator": "^8.1.0",
    "playwright": "1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@data-slot/dialog": "^1.0.2",
    "@data-slot/navigation-menu": "^1.0.2",
    "@lexingtonthemes/seo": "^0.4.0",
    "@lucide/astro": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-static": "^1.49.0",
    "posthog-js": "1.434.15",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
