{
  "ignoreBinaries": ["vp"],
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The page route loads layouts through import.meta.glob.
  "entry": ["src/layouts/*.astro"],
  "playwright": { "config": ["tests/browser/playwright.config.ts"] },
  // Fulldev UI components export every part; an unused component still fails.
  "ignoreIssues": { "src/components/ui/**": ["exports", "types"] },
  "ignoreDependencies": [
    // Read from node_modules by the Icon component.
    "lucide-static",
    "simple-icons",
  ],
}
