<script>
  import { afterLoad } from "@/lib/after-load"
  import { scrubUrls } from "@/lib/posthog-urls"

  // The shared full.dev PostHog project key (EU cloud). Public by design.
  // Leave it empty to turn analytics off.
  const key: string = "phc_txCmZNAK3YueTeNyvtXmnh9JvK2LdbF3hK3kvxRcEJou"

  if (
    key &&
    !navigator.webdriver &&
    window.location.hostname === new URL(import.meta.env.SITE).hostname
  )
    afterLoad(async () => {
      const { PostHog } = await import("posthog-js")
      const posthog = new PostHog()
      // The same-origin proxy must not receive existing app/legacy cookies.
      const fetchOptions: RequestInit = {
        credentials: "omit",
        cache: "no-store",
      }
      posthog.init(key, {
        api_host: "/ingest",
        api_transport: "fetch",
        disable_beacon: true,
        fetch_options: fetchOptions,
        ui_host: "https://eu.posthog.com",
        defaults: "2026-08-30",
        // No persistent visitor ID; SDK cleanup stays separate from app storage.
        cookieless_mode: "always",
        persistence: "memory",
        persistence_name: "website",
        person_profiles: "never",
        // Also prevents reading advertising IDs from URL parameters or cookies.
        save_campaign_params: false,
        capture_pageview: true,
        capture_pageleave: true,
        autocapture: false,
        capture_dead_clicks: false,
        capture_heatmaps: false,
        capture_exceptions: false,
        capture_performance: false,
        disable_session_recording: true,
        disable_surveys: true,
        disable_product_tours: true,
        disable_conversations: true,
        advanced_disable_flags: true,
        before_send: (event) =>
          event && ["$pageview", "$pageleave"].includes(event.event)
            ? scrubUrls(event)
            : null,
      })
    })
</script>
