---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"a"> & {
  active?: boolean
}

const {
  class: className,
  active,
  "aria-current": ariaCurrent = active ? "page" : undefined,
  ...props
} = Astro.props
---

<a
  data-slot="navigation-menu-link"
  data-active={active ? "true" : undefined}
  aria-current={ariaCurrent}
  class={cn("data-[active=true]:focus:bg-muted data-[active=true]:hover:bg-muted data-[active=true]:bg-muted/50 focus-visible:ring-ring/50 hover:bg-muted focus:bg-muted flex items-center gap-1.5 rounded-md p-2 text-sm transition-all outline-none focus-visible:ring-3 focus-visible:outline-1 [&_svg:not([class*='size-'])]:size-4 in-data-[slot=navigation-menu-content]:rounded-sm", className)}
  {...props}
>
  <slot />
</a>
