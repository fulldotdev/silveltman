---
// The footer at the bottom of the dark end, as on full.dev: the name with
// the description and the social buttons, the page columns and the contact
// details, then the copyright and the legal links.
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import { Section, SectionContainer } from "@/components/ui/section"

type Link = { label: string; href: string }

type Props = {
  name: string
  href: string
  description: string
  socials: Link[]
  columns: { title: string; links: Link[] }[]
  contact: { title: string; links: Link[] }
  legal: Link[]
  copyright: string
}

const { name, href, description, socials, columns, contact, legal, copyright } =
  Astro.props

// Simple Icons and Lucide have no LinkedIn logo, so it is drawn here.
const linkedin =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.119 20.452H3.554V9h3.565v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
---

<footer class="site-footer">
  <Section class="pt-8! pb-10! lg:pt-12!">
    <SectionContainer class="flex flex-col gap-12">
      <div class="grid grid-cols-2 gap-12 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
        <div class="col-span-2 flex flex-col items-start gap-5 lg:col-span-1">
          <a href={href} class="text-title font-medium">
            {name}
          </a>
          <p class="text-muted-foreground text-copy max-w-(--fd-measure-narrow)">
            {description}
          </p>
          <ul class="flex flex-wrap gap-2">
            {socials.map((social) => (
              <li>
                <Button
                  as="a"
                  href={social.href}
                  target="_blank"
                  rel="noreferrer"
                  variant="outline"
                  size="icon-lg"
                  aria-label={social.label}
                >
                  {social.label === "LinkedIn" ? (
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d={linkedin} />
                    </svg>
                  ) : (
                    <Icon href={social.href} />
                  )}
                </Button>
              </li>
            ))}
          </ul>
        </div>
        {[...columns, contact].map((column) => (
          <div class="flex flex-col gap-4">
            <h2 class="text-ui font-medium">{column.title}</h2>
            <ul class="flex flex-col gap-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-muted-foreground hover:text-foreground text-ui transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="text-muted-foreground flex flex-col gap-3 border-t pt-8 text-sm sm:flex-row sm:justify-between">
        <p>{copyright}</p>
        <ul class="flex gap-5">
          {legal.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-foreground transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </SectionContainer>
  </Section>
</footer>
