---
// The footer at the end of every page: the dark end, centred. The call to
// action (a title, one line and the button to the contact page), the
// social buttons, and the copyright with the legal links. The contact page
// leaves the call to action out.
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import { Section, SectionContainer } from "@/components/ui/section"

type Link = { label: string; href: string }

type Props = {
  cta?: { title: string; description: string; button: Link }
  socials: Link[]
  legal: Link[]
  copyright: string
}

const { cta, socials, legal, copyright } = Astro.props

// Simple Icons and Lucide have no LinkedIn logo, so it is drawn here.
const linkedin =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.119 20.452H3.554V9h3.565v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
---

<footer>
  <Section class:list={["pb-10!", cta ? "pt-20! sm:pt-28!" : "pt-12!"]}>
    <SectionContainer class="flex flex-col items-center text-center">
      {cta && (
        <>
          <h2 class="text-closing max-w-(--fd-measure) text-balance">
            {cta.title}
          </h2>
          <p class="text-muted-foreground text-copy mt-5 max-w-(--fd-measure-narrow) text-balance">
            {cta.description}
          </p>
          <Button as="a" href={cta.button.href} size="lg" class="mt-9">
            {cta.button.label}
          </Button>
        </>
      )}
      <ul class:list={["flex flex-wrap justify-center gap-2", cta && "mt-14"]}>
        {socials.map((social) => (
          <li>
            <Button
              as="a"
              href={social.href}
              target="_blank"
              rel="noreferrer"
              variant="outline"
              size="icon-lg"
              aria-label={social.label}
            >
              {social.label === "LinkedIn" ? (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={linkedin} />
                </svg>
              ) : (
                <Icon href={social.href} />
              )}
            </Button>
          </li>
        ))}
      </ul>
      <div class="text-muted-foreground mt-14 flex w-full flex-wrap justify-center gap-x-5 gap-y-2 border-t pt-8 text-sm">
        <p>{copyright}</p>
        {legal.map((link) => (
          <a href={link.href} class="hover:text-foreground transition-colors">
            {link.label}
          </a>
        ))}
      </div>
    </SectionContainer>
  </Section>
</footer>
