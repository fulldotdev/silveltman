---
// A company with its screenshot on its own tint, the logo, what it is and
// the tags. The whole card links to the project page on full.dev, or to the
// company's site when there is none.
import { Image } from "astro:assets"
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right"

import type { CompanySchema } from "@/schemas/company"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import { Card } from "@/components/ui/card"

type Props = {
  company: CompanySchema
  viaLabel: string
  projectLabel: string
}

const { company, viaLabel, projectLabel } = Astro.props
const href = company.project ?? company.url
---

<Card
  as="a"
  href={href}
  target="_blank"
  rel="noreferrer"
  class="group gap-0 p-2"
>
  {company.screenshot && (
    <div
      class="panel relative aspect-[16/10] rounded-[calc(var(--fd-r-card)-0.5rem)] px-6 pt-6 sm:px-8 sm:pt-8"
      style={{ backgroundColor: company.tint }}
    >
      <Image
        src={company.screenshot}
        alt=""
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 64rem) 40rem, 100vw"
        class="bg-screen shadow-desk ease-settle h-auto w-full rounded-t-(--fd-r-avatar) transition-transform duration-500 group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0"
      />
    </div>
  )}
  <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
    <div class="flex min-h-9 items-center justify-between gap-4">
      {company.logo ? (
        <Image
          src={company.logo.src}
          alt=""
          height={company.logo.height}
          class="w-auto max-w-44 object-contain opacity-70 brightness-0"
          style={{ height: `${company.logo.height}px` }}
        />
      ) : (
        <h3 class="text-title font-medium">{company.name}</h3>
      )}
      <Button as="span" variant="outline" size="icon" aria-hidden="true">
        <ArrowUpRight />
      </Button>
    </div>
    {company.logo && <h3 class="sr-only">{company.name}</h3>}
    <p class="text-copy text-muted-foreground">{company.scope}</p>
    {(company.tags.length > 0 || company.via) && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-2">
        {company.via && (
          <Badge as="li" variant="outline">
            {`${viaLabel} ${company.via}`}
          </Badge>
        )}
        {company.tags.map((tag) => (
          <Badge as="li" variant="outline">
            {tag}
          </Badge>
        ))}
      </ul>
    )}
    <span class="sr-only">{projectLabel}</span>
  </div>
</Card>
