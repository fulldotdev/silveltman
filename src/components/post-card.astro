---
// A post in a list: the date and channel, the title, its first lines and
// the arrow. The card links to the post's page.
import ArrowRight from "@lucide/astro/icons/arrow-right"

import { Button } from "@/components/ui/button"
import { Card, CardDescription, CardTitle } from "@/components/ui/card"

type Props = {
  href: string
  title: string
  description: string
  date: string
  category: string
  headingLevel?: "h2" | "h3"
}

const {
  href,
  title,
  description,
  date,
  category,
  headingLevel = "h3",
} = Astro.props
---

<Card as="a" href={href} class="group h-full gap-4 px-(--card-spacing)">
  <p class="text-muted-foreground text-sm">{`${date} · ${category}`}</p>
  <CardTitle as={headingLevel} class="text-balance">
    {title}
  </CardTitle>
  <CardDescription class="line-clamp-3">{description}</CardDescription>
  <Button
    as="span"
    variant="outline"
    size="icon"
    class="mt-auto self-end"
    aria-hidden="true"
  >
    <ArrowRight />
  </Button>
</Card>
