---
// The small card icon: a 2 by 2 grid of blocks with one lit block, `lit`
// counting top left (0), top right, bottom left, bottom right (3). Cards
// in a row each light another block (blocks/landing-points.astro, and
// full.dev's blocks/project-detail.astro).
import Block from "@/components/block-3d.astro"
import BlockScene from "@/components/block-scene.astro"

interface Props {
  lit: number
}
const { lit } = Astro.props
---

<BlockScene
  width={53}
  height={53}
  floor="grid grid-cols-2 gap-1.25"
  class="size-14"
>
  {[0, 1, 2, 3].map((cell) => (
    <Block size={24} depth={8} tone={cell === lit ? "lit" : "white"} />
  ))}
</BlockScene>
