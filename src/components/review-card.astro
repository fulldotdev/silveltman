---
// A review as published on full.dev: the quote, then the face or initials,
// the name and the company.
import type { ImageMetadata } from "astro"

import { getInitials } from "@/lib/content"
import { cn } from "@/lib/utils"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"
import { Card } from "@/components/ui/card"

type Props = {
  name: string
  company?: string
  quote: string
  image?: ImageMetadata
  class?: string
}

const { name, company, quote, image, class: className } = Astro.props
---

<Card
  as="figure"
  class={cn("m-0 break-inside-avoid gap-6 px-(--card-spacing)", className)}
>
  <blockquote class="text-copy">“{quote}”</blockquote>
  <figcaption class="flex items-center gap-3">
    <Avatar class="size-10">
      {image && <AvatarImage src={image} alt="" />}
      <AvatarFallback class="bg-muted">{getInitials(name)}</AvatarFallback>
    </Avatar>
    <div>
      <p class="font-medium">{name}</p>
      {company && <p class="text-muted-foreground text-sm">{company}</p>}
    </div>
  </figcaption>
</Card>
