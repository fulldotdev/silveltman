---
// The closing call to action at the end of every page, the top of the dark
// end: a centred title, one line, the ways to reach Sil and his face. Under
// it a floor of blocks with one orange block in the middle, which runs a
// slow wave once it is in view.
import type { ImageMetadata } from "astro"

import { Avatar, AvatarImage } from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import { Section, SectionContainer } from "@/components/ui/section"
import Block from "@/components/block-3d.astro"
import BlockScene from "@/components/block-scene.astro"

type Props = {
  title: string
  description: string
  buttons: { label: string; href: string; icon: string }[]
  person: { name: string; role: string; avatar: ImageMetadata }
}

const { title, description, buttons, person } = Astro.props

const count = 21
const size = 36
const pitch = 48
const lit = Math.floor(count / 2)
---

<Section class="closing" aria-labelledby="closing-title">
  <SectionContainer class="flex flex-col items-center text-center">
    <h2
      id="closing-title"
      class="text-closing max-w-(--fd-measure) text-balance"
    >
      {title}
    </h2>
    <p class="text-muted-foreground text-copy mt-5 max-w-(--fd-measure-narrow)">
      {description}
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      {buttons.map((button, index) => (
        <Button
          as="a"
          href={button.href}
          size="lg"
          variant={index === 0 ? "default" : "outline"}
          target={button.href.startsWith("http") ? "_blank" : undefined}
          rel={button.href.startsWith("http") ? "noreferrer" : undefined}
        >
          <Icon name={button.icon} />
          {button.label}
        </Button>
      ))}
    </div>
    <div class="mt-10 flex items-center gap-3 text-left">
      <Avatar class="size-11">
        <AvatarImage src={person.avatar} alt="" />
      </Avatar>
      <div>
        <p class="font-medium">{person.name}</p>
        <p class="text-muted-foreground text-sm">{person.role}</p>
      </div>
    </div>
    <BlockScene
      width={count * pitch - (pitch - size)}
      height={size}
      floor="flex justify-between"
      class="closing-floor mt-14 h-28 w-full"
    >
      {Array.from({ length: count }, (_, index) => (
        <Block
          size={size}
          depth={12}
          step={3}
          tone={index === lit ? "lit" : "white"}
          motion="wave"
          class:list={[
            "floor-block",
            Math.abs(index - lit) > 6 && "wide",
            Math.abs(index - lit) > 3 && "mid",
          ]}
          style={{ "--i": Math.abs(index - lit), "--wave": "8s" }}
        />
      ))}
    </BlockScene>
  </SectionContainer>
</Section>

<style>
  /* The floor's blocks take the raised face, so they read as filled. */
  .floor-block:not(.b3d-lit) {
    --face: var(--fd-block-fill-floor);
    --side: var(--fd-block-side-floor);
  }
  /* Narrower screens show fewer blocks, so the row still fits. */
  @media (width < 64rem) {
    .closing-floor .wide {
      display: none;
    }
    .closing-floor {
      --w: 612px !important;
    }
  }
  @media (width < 40rem) {
    .closing-floor .mid {
      display: none;
    }
    .closing-floor {
      --w: 324px !important;
    }
  }
</style>
