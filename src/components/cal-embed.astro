---
// The Cal.com booking page of `url`, inline through Cal.com's official
// embed.js, once per page. The embed grows with the booking, so the page
// scrolls instead of the frame. The direct link shows when JavaScript or
// Cal.com does not load.
//
// Cal.com loads the booking its own way: with cal.embed.pageType, embed.js
// draws a skeleton of the booking at once, the frame takes over with its own
// skeleton, and the times slide in beside the calendar. While they slide,
// the booking overflows the frame for about 350ms. So:
// - the frame never scrolls (scrolling="no"): Cal.com sizes it to the
//   booking, so an overflow while it moves only clips for a moment;
// - at most 896px wide, as on full.dev: Cal.com's layout needs 1040px once
//   its frame is 1024px wide or more;
// - a spinner shows only until embed.js has drawn its skeleton;
// - the frame stays out of the layout, under the skeleton, until linkReady:
//   Cal.com sizes the skeleton for a 300px frame below it, so a frame that
//   grows before the skeleton goes made the booking jump.
// The space: up to a 768px frame, the viewport less 40px of padding, Cal.com
// stacks the booking, about 85vw + 50rem high with a day of times, and less
// as the day's times pass. That is held only until the frame shows, so no
// space is left over below the fold. Wider, it is one row of 534 to 571px,
// held throughout so the footer in view stays put.
// The attribute is not data-cal-link: embed.js opens a popup for any click
// inside an element with that attribute.
import { Spinner } from "@/components/ui/spinner"

type Props = {
  url: string
  linkLabel: string
  loadingLabel: string
  class?: string
}

const { url, linkLabel, loadingLabel, class: className } = Astro.props
const calLink = new URL(url).pathname.replace(/^\/|\/$/g, "")
---

<div
  data-cal-embed={calLink}
  class:list={[
    "group relative w-full max-w-4xl text-center",
    "data-[state=loading]:min-h-[calc(85vw+50rem)]",
    "min-[809px]:data-[state=loading]:min-h-143 min-[809px]:data-[state=ready]:min-h-143",
    "[&:not([data-state=ready])_iframe]:absolute [&:not([data-state=ready])_iframe]:top-0",
    "data-[state=failed]:[&>cal-inline]:hidden!",
    className,
  ]}
>
  <a
    href={url}
    class="underline underline-offset-4 group-data-[state=loading]:hidden group-data-[state=ready]:hidden"
  >
    {linkLabel}
  </a>
  <Spinner
    class="text-muted-foreground absolute inset-x-0 top-24 mx-auto hidden size-6 group-data-[state=loading]:block group-has-[cal-inline]:hidden!"
    aria-label={loadingLabel}
  />
</div>

<script is:inline>
  // The loader of Cal.com's Embed Snippet Generator
  // (cal.com/help/embedding/adding-embed), with rest parameters.
  ;(function (C, A, L) {
    const p = (a, ar) => a.q.push(ar)
    const d = C.document
    C.Cal =
      C.Cal ||
      function (...ar) {
        const cal = C.Cal
        if (!cal.loaded) {
          cal.ns = {}
          cal.q = cal.q || []
          d.head.appendChild(d.createElement("script")).src = A
          cal.loaded = true
        }
        if (ar[0] === L) {
          const api = (...args) => p(api, args)
          const namespace = ar[1]
          api.q = api.q || []
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api
            p(cal.ns[namespace], ar)
            p(cal, ["initNamespace", namespace])
          } else p(cal, ar)
          return
        }
        p(cal, ar)
      }
  })(window, "https://app.cal.com/embed/embed.js", "init")

  const box = document.querySelector("[data-cal-embed]")
  const setState = (state) => (box.dataset.state = state)
  setState("loading")

  Cal("init", { origin: "https://app.cal.com" })
  document
    .querySelector('script[src="https://app.cal.com/embed/embed.js"]')
    .addEventListener("error", () => setState("failed"))
  new MutationObserver((_, observer) => {
    const iframe = box.querySelector("iframe")
    if (!iframe) return
    iframe.setAttribute("scrolling", "no")
    observer.disconnect()
  }).observe(box, { childList: true, subtree: true })
  Cal("inline", {
    elementOrSelector: box,
    calLink: box.dataset.calEmbed,
    config: {
      layout: "month_view",
      "cal.embed.pageType": "user.event.booking.slots",
      // The skeleton's theme. Without it, the skeleton follows the visitor's
      // system and turns dark beside the light booking.
      theme: "light",
    },
  })
  Cal("ui", { theme: "light", layout: "month_view" })

  // Cal.com shows its frame at linkReady. When Cal.com fails, or the frame is
  // not there after 10 seconds, the link shows instead. Only a slow frame
  // still takes over: Cal.com keeps a failed one hidden.
  let calFailed = false
  Cal("on", {
    action: "linkReady",
    callback: () => calFailed || setState("ready"),
  })
  Cal("on", {
    action: "linkFailed",
    callback: () => {
      calFailed = true
      setState("failed")
    },
  })
  setTimeout(() => {
    if (box.dataset.state === "loading") setState("failed")
  }, 10000)
</script>
