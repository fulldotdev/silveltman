---
// The Cal.com booking page of `url`, inline through Cal.com's official
// embed.js, as on full.dev's contact page. The embed grows with the
// booking, so the page scrolls instead of the frame. The direct link shows
// until the calendar is in, so it stays when JavaScript or Cal.com's script
// does not run.
//
// No scrollbars inside the frame:
// - Cal.com's layout needs 1040px once its frame is 1024px wide or more,
//   so a frame of 1024 to 1039px scrolls sideways. At most 896px, as on
//   full.dev, keeps the frame below that range.
// - Cal.com shows the frame at 300px high before it measures the booking,
//   which scrolls for a moment. The frame stays transparent until Cal.com
//   reports linkReady, after its first measurement (see reveal below), and
//   the space the booking takes at 896px is kept free meanwhile.
type Props = {
  url: string
  linkLabel: string
  class?: string
}

const { url, linkLabel, class: className } = Astro.props
const calLink = new URL(url).pathname.replace(/^\/|\/$/g, "")
---

<div
  data-cal-link={calLink}
  class:list={[
    "w-full max-w-4xl min-h-96 lg:min-h-134 text-center has-[iframe]:[&>a]:hidden [&_iframe]:transition-opacity [&:not([data-ready])_iframe]:opacity-0",
    className,
  ]}
>
  <a href={url} class="underline underline-offset-4">
    {linkLabel}
  </a>
</div>

<script is:inline>
  // The loader of Cal.com's Embed Snippet Generator
  // (cal.com/help/embedding/adding-embed), with rest parameters.
  ;(function (C, A, L) {
    const p = (a, ar) => a.q.push(ar)
    const d = C.document
    C.Cal =
      C.Cal ||
      function (...ar) {
        const cal = C.Cal
        if (!cal.loaded) {
          cal.ns = {}
          cal.q = cal.q || []
          d.head.appendChild(d.createElement("script")).src = A
          cal.loaded = true
        }
        if (ar[0] === L) {
          const api = (...args) => p(api, args)
          const namespace = ar[1]
          api.q = api.q || []
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api
            p(cal.ns[namespace], ar)
            p(cal, ["initNamespace", namespace])
          } else p(cal, ar)
          return
        }
        p(cal, ar)
      }
  })(window, "https://app.cal.com/embed/embed.js", "init")

  Cal("init", { origin: "https://app.cal.com" })
  for (const element of document.querySelectorAll("[data-cal-link]")) {
    Cal("inline", {
      elementOrSelector: element,
      calLink: element.dataset.calLink,
      config: { layout: "month_view" },
    })
  }
  Cal("ui", { theme: "light", layout: "month_view" })
  // Show the frame once Cal.com has measured it, or has shown its own error
  // page; after 8 seconds in any case, so it never stays hidden.
  const reveal = () => {
    for (const element of document.querySelectorAll("[data-cal-link]"))
      element.setAttribute("data-ready", "")
  }
  Cal("on", { action: "linkReady", callback: reveal })
  Cal("on", { action: "linkFailed", callback: reveal })
  setTimeout(reveal, 8000)
</script>
