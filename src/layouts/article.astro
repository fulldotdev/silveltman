---
import { Image } from "astro:assets"
import ArrowLeft from "@lucide/astro/icons/arrow-left"
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right"
import type { BlogPosting, WithContext } from "schema-dts"

import type { GlobalSchema } from "@/schemas/global"
import type { ArticleSchema } from "@/schemas/layouts/article"
import { formatDate } from "@/lib/content"
import Base from "@/layouts/base.astro"
import { Avatar, AvatarImage } from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import { Section, SectionContainer } from "@/components/ui/section"
import { Typography, TypographyH1 } from "@/components/ui/typography"

type Props = {
  global: GlobalSchema
  page: ArticleSchema
}

const { global, page } = Astro.props
const locale = Astro.currentLocale
const parent = Astro.url.pathname.split("/").slice(0, -2).join("/") + "/"

const jsonLd: WithContext<BlogPosting> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: page.title,
  description: page.description,
  datePublished: page.date.toISOString(),
  dateModified: (page.updated ?? page.date).toISOString(),
  author: {
    "@type": "Person",
    name: global.person.name,
    url: Astro.site?.href,
  },
  inLanguage: locale,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  sameAs: page.source?.href,
}
---

<Base global={global} page={page}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
  />
  <Section class="pt-12! sm:pt-16!">
    <SectionContainer class="max-w-[calc(var(--fd-measure)+2*var(--gutter))]">
      <Button as="a" href={parent} variant="ghost" class="-ml-3">
        <ArrowLeft />
        Alle posts
      </Button>
      <article class="mt-8 flex flex-col">
        <header class="flex flex-col gap-6">
          <p class="text-muted-foreground text-ui">
            <time datetime={page.date.toISOString()}>
              {formatDate(page.date, locale)}
            </time>
            {` · ${page.category}`}
          </p>
          <TypographyH1>{page.title}</TypographyH1>
          <div class="flex items-center gap-3">
            <Avatar class="size-10">
              <AvatarImage src={global.person.avatar} alt="" />
            </Avatar>
            <div>
              <p class="font-medium">{global.person.name}</p>
              <p class="text-muted-foreground text-sm">{global.person.role}</p>
            </div>
          </div>
        </header>
        {page.image && (
          <Image
            src={page.image.src}
            alt={page.image.alt}
            class="panel mt-10 w-full"
            widths={[640, 960, 1280]}
            sizes="(min-width: 45rem) 45rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        )}
        <Typography class="site-prose mt-10">
          <slot />
        </Typography>
        {page.source && (
          <Button
            as="a"
            href={page.source.href}
            target="_blank"
            rel="noreferrer"
            variant="outline"
            size="lg"
            class="mt-12 self-start"
          >
            {page.source.label}
            <ArrowUpRight />
          </Button>
        )}
      </article>
    </SectionContainer>
  </Section>
</Base>
