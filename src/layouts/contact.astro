---
import type { GlobalSchema } from "@/schemas/global"
import type { ContactSchema } from "@/schemas/layouts/contact"
import Base from "@/layouts/base.astro"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import { Section, SectionContainer } from "@/components/ui/section"
import { TypographyH1, TypographyLead } from "@/components/ui/typography"
import CalEmbed from "@/components/cal-embed.astro"

type Props = {
  global: GlobalSchema
  page: ContactSchema
}

const { global, page } = Astro.props
const { options, booking } = page
---

<Base global={global} page={page}>
  <Section class="pt-16! sm:pt-24!">
    <SectionContainer class="flex flex-col items-center">
      <header class="section-head">
        <TypographyH1>{page.title}</TypographyH1>
        <TypographyLead>{page.lead}</TypographyLead>
      </header>
      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {options.map((option) => (
          <li>
            <Button
              as="a"
              href={option.href}
              target={option.href.startsWith("http") ? "_blank" : undefined}
              rel={option.href.startsWith("http") ? "noreferrer" : undefined}
              variant="outline"
              size="lg"
            >
              <Icon name={option.icon} />
              {option.label}
            </Button>
          </li>
        ))}
      </ul>
      <CalEmbed
        url={booking.url}
        linkLabel={booking.linkLabel}
        class="mt-14 w-full max-w-5xl"
      />
    </SectionContainer>
  </Section>
</Base>
