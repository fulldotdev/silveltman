---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right"

import type { GlobalSchema } from "@/schemas/global"
import type { ContactSchema } from "@/schemas/layouts/contact"
import Base from "@/layouts/base.astro"
import { Button } from "@/components/ui/button"
import { Card, CardDescription, CardTitle } from "@/components/ui/card"
import { Icon } from "@/components/ui/icon"
import { Section, SectionContainer } from "@/components/ui/section"
import {
  Typography,
  TypographyH1,
  TypographyLead,
} from "@/components/ui/typography"

type Props = {
  global: GlobalSchema
  page: ContactSchema
}

const { global, page } = Astro.props
---

<Base global={global} page={page}>
  <Section class="pt-16! sm:pt-24!">
    <SectionContainer class="flex flex-col">
      <header class="section-head">
        <TypographyH1>{page.title}</TypographyH1>
        <TypographyLead>{page.lead}</TypographyLead>
      </header>
      <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {page.options.map((option, index) => {
          const external = option.href.startsWith("http")
          return (
            <li class="flex">
              <Card
                as="a"
                href={option.href}
                target={external ? "_blank" : undefined}
                rel={external ? "noreferrer" : undefined}
                class="group w-full gap-4 px-(--card-spacing)"
              >
                <span class="bg-muted text-foreground grid size-11 place-items-center rounded-(--fd-r-well)">
                  <Icon name={option.icon} class="size-5" />
                </span>
                <CardTitle as="h2" class="mt-2">
                  {option.title}
                </CardTitle>
                <CardDescription>{option.description}</CardDescription>
                <span class="text-ui mt-auto flex items-center justify-between gap-3 pt-2 font-medium">
                  {option.label}
                  <Button
                    as="span"
                    variant={index === 0 ? "default" : "outline"}
                    size="icon"
                    aria-hidden="true"
                  >
                    <ArrowUpRight />
                  </Button>
                </span>
              </Card>
            </li>
          )
        })}
      </ul>
      <Typography class="site-prose mx-auto mt-16 text-center">
        <slot />
      </Typography>
    </SectionContainer>
  </Section>
</Base>
