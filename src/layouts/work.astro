---
import { Image } from "astro:assets"
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right"

import type { GlobalSchema } from "@/schemas/global"
import type { WorkSchema } from "@/schemas/layouts/work"
import { getCompanies } from "@/lib/content"
import Base from "@/layouts/base.astro"
import { Card } from "@/components/ui/card"
import {
  Section,
  SectionContainer,
  SectionDescription,
  SectionTitle,
} from "@/components/ui/section"
import { TypographyH1, TypographyLead } from "@/components/ui/typography"
import CompanyCard from "@/components/company-card.astro"

type Props = {
  global: GlobalSchema
  page: WorkSchema
}

const { global, page } = Astro.props

const clients = await getCompanies("client")
const featured = clients.filter((company) => company.data.screenshot)
const others = clients.filter((company) => !company.data.screenshot)
const agencies = await getCompanies("agency")
---

<Base global={global} page={page}>
  <Section class="pt-16! sm:pt-24!">
    <SectionContainer class="flex flex-col">
      <header class="section-head">
        <TypographyH1>{page.title}</TypographyH1>
        <TypographyLead>{page.lead}</TypographyLead>
      </header>
      <div class="mt-16">
        <h2 class="sr-only">{page.featured.title}</h2>
        <ul class="grid gap-5 md:grid-cols-2">
          {featured.map((company) => (
            <li class="flex">
              <CompanyCard
                company={company.data}
                viaLabel={page.viaLabel}
                projectLabel={`${page.projectLabel} ${company.data.name}`}
              />
            </li>
          ))}
        </ul>
      </div>
    </SectionContainer>
  </Section>

  <Section class="pt-0!">
    <SectionContainer class="flex flex-col">
      <div class="section-head">
        <SectionTitle>{page.agencies.title}</SectionTitle>
        <SectionDescription>{page.agencies.description}</SectionDescription>
      </div>
      <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {agencies.map(({ data: agency }) => (
          <li class="flex">
            <Card
              as="a"
              href={agency.url}
              target="_blank"
              rel="noreferrer"
              class="group w-full gap-5 px-(--card-spacing)"
            >
              <div class="flex h-10 items-center justify-between gap-3">
                {agency.logo && (
                  <Image
                    src={agency.logo.src}
                    alt=""
                    height={agency.logo.height}
                    class="w-auto max-w-40 object-contain opacity-70 brightness-0"
                    style={{ height: `${agency.logo.height}px` }}
                  />
                )}
                <ArrowUpRight class="text-muted-foreground size-4 shrink-0" />
              </div>
              <h3 class="text-title">{agency.name}</h3>
              <p class="text-copy text-muted-foreground">{agency.scope}</p>
            </Card>
          </li>
        ))}
      </ul>
    </SectionContainer>
  </Section>

  <Section class="pt-0!">
    <SectionContainer class="flex flex-col">
      <div class="section-head">
        <SectionTitle>{page.clients.title}</SectionTitle>
        <SectionDescription>{page.clients.description}</SectionDescription>
      </div>
      <ul class="mx-auto mt-16 grid w-full max-w-(--container) gap-x-10 md:grid-cols-2">
        {others.map(({ data: company }) => (
          <li class="border-t py-6">
            <a
              href={company.project ?? company.url}
              target="_blank"
              rel="noreferrer"
              class="group flex items-start justify-between gap-6"
            >
              <span class="flex flex-col gap-1.5">
                <span class="text-title group-hover:underline group-hover:underline-offset-4">
                  {company.name}
                </span>
                <span class="text-copy text-muted-foreground">
                  {company.scope}
                </span>
              </span>
              <ArrowUpRight class="text-muted-foreground mt-1.5 size-4 shrink-0" />
            </a>
          </li>
        ))}
      </ul>
    </SectionContainer>
  </Section>
</Base>
