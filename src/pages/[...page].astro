---
// Keep this route generic. A new page type needs a schema in
// src/schemas/layouts, an entry in src/schemas/page.ts and a layout in
// src/layouts with the same name, not a branch here.
import { getCollection, render } from "astro:content"

import { getGlobal } from "@/lib/content"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  return pages.map((page) => ({
    params: { page: page.id === "index" ? undefined : page.id },
    props: { page },
  }))
}

const { page } = Astro.props
const { Content, headings } = await render(page)
const global = await getGlobal(Astro.currentLocale)

const layouts = import.meta.glob<{ default: any }>("../layouts/*.astro", {
  eager: true,
})
const Layout = layouts[`../layouts/${page.data.type}.astro`]?.default
if (!Layout) throw new Error(`Add src/layouts/${page.data.type}.astro`)
---

<Layout global={global} page={page.data} entry={page} headings={headings}>
  <Content />
</Layout>
